            Rational[1, 2], 
            Rational[1, 2], 
            Rational[-1, 2]}, {
            Rational[1, 2], 
            Rational[1, 2], 
            Rational[1, 2]}}, {{8, 4, 2, 6}, {8, 6, 5, 7}, {8, 7, 3, 4}, {4, 
          3, 1, 2}, {1, 3, 7, 5}, {2, 1, 5, 6}}]]]}, 
       TagBox[{
         PolyhedronBox[
          NCache[{{Rational[-1, 2], Rational[-1, 2], Rational[-1, 2]}, {
